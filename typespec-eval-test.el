(ert-deftest typespec-eval-float-aliases ()
  (should (equal (typespec-eval 'positive-float)
                 '(float (0) *)))
  (should (equal (typespec-eval 'negative-float)
                 '(float * (0))))
  (should (equal (typespec-eval 'non-negative-float)
                 '(float 0.0 *)))
  (should (equal (typespec-eval 'non-positive-float)
                 '(float * 0.0))))

(ert-deftest typespec-eval-arithmetic ()
  (should (equal (typespec-eval '(+ 1 2 3))
                 '(const 6)))
  (should (equal (typespec-eval '(* 2 3))
                 '(const 6)))
  (should (equal (typespec-eval '(- 3 1))
                 '(const 2)))
  (should (equal (typespec-eval '(/ 8 2))
                 '(const 4)))
  (should (equal (typespec-eval '(% 7 3))
                 '(const 1)))
  (should (equal (typespec-eval '(mod 7 3))
                 '(const 1)))
  (should (equal (typespec-eval '(mod (integer 0 10) (integer 2 5)))
                 '(integer 0 4)))
  (should (equal (typespec-eval '(mod (integer 0 10) (integer -5 -2)))
                 '(integer -4 0)))
  (should (equal (typespec-eval '(% (integer 0 10) (integer 2 5)))
                 '(integer 0 4)))
  (should (equal (typespec-eval '(% (integer -10 -1) (integer 2 5)))
                 '(integer -4 0)))
  (should (equal (typespec-eval '(% (integer -10 10) (integer 2 5)))
                 '(integer -4 4)))
  (should (equal (typespec-eval '(/ integer (integer 0 2)))
                 'unknown))
  (should (equal (typespec-eval '(/ integer (const 0)))
                 'never))
  (should (equal (typespec-eval '(mod integer (integer 0 2)))
                 'unknown))
  (should (equal (typespec-eval '(mod integer (const 0)))
                 'never))
  (should (equal (typespec-eval '(% integer (integer 0 2)))
                 'unknown))
  (should (equal (typespec-eval '(% integer (const 0)))
                 'never))
  (should (equal (typespec-eval '(+ number-or-marker number-or-marker))
                 'number))
  (should (equal (typespec-eval '(- integer-or-marker integer-or-marker))
                 'integer))
  (should (equal (typespec-eval '(+ integer integer))
                 'integer))
  (should (equal (typespec-eval '(* float float))
                 'float))
  (should (equal (typespec-eval '(- number number))
                 'number))
  (should (equal (typespec-eval '(mod float float))
                 'float)))

(ert-deftest typespec-eval-arithmetic-or-integer-range ()
  "Test arithmetic with integer ranges and `(or ...)`."
  (should (equal (typespec-eval '(+ (or 1 2) (or 1 2)))
                 '(or (const 2) (const 3) (const 4))))
  (should (equal (typespec-eval '(+ (integer 1 2) (or 1 2)))
                 '(or (const 2) (const 3) (const 4))))
  (should (equal (typespec-eval '(+ (integer 1 2) (integer 1 2)))
                 '(or (const 2) (const 3) (const 4)))))

(ert-deftest typespec-eval-arithmetic-float-ranges ()
  "Test arithmetic over float ranges."
  (should (equal (typespec-eval '(+ 1 (float 1 *)))
                 '(float 2.0 *)))
  (should (equal (typespec-eval '(- 1 (float 1 *)))
                 '(float * 0.0)))
  (should (equal (typespec-eval '(+ 1 (float 1 2)))
                 '(float 2.0 3.0)))
  (should (equal (typespec-eval '(* 1 (float 1 2)))
                 '(float 1.0 2.0)))
  (should (equal (typespec-eval '(/ 1 (float 1 2)))
                 '(float 0.5 1.0)))
  (should (equal (typespec-eval '(/ (float 1 2) 1))
                 '(float 1.0 2.0)))
  (should (equal (typespec-eval '(+ (float 1 2) (float 1 2)))
                 '(float 2.0 4.0))))

(ert-deftest typespec-eval-arithmetic-number-real-ranges ()
  "Test arithmetic over number/real ranges."
  (should (equal (typespec-eval '(+ (number 0 1) (number 1 2)))
                 '(number 1 3)))
  (should (equal (typespec-eval '(- (number 0 1) (number 1 2)))
                 '(number -2 0)))
  (should (equal (typespec-eval '(* (number 0 2) (number 3 4)))
                 '(number 0 8)))
  (should (equal (typespec-eval '(/ (number 2 4) (number 1 2)))
                 '(number 1 4)))
  (should (equal (typespec-eval '(+ (real 0 1) (real 1 2)))
                 '(real 1 3))))

