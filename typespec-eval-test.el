;;; Commentary:

;; Tests for the typespec evaluator.

;;; Code:

(require 'ert)
(require 'seq)
(require 'typespec-eval)

(ert-deftest typespec-eval-eq ()
  (should (equal (typespec-eval '(eq (const 1) (const 1)))
                 '(const t)))
  (should (equal (typespec-eval '(eq (const 1) (const 2)))
                 '(const nil)))
  (should (equal (typespec-eval '(eq number number)) 'boolean))
  (should (equal (typespec-eval '(eq unknown unknown)) 'boolean)))

(ert-deftest typespec-eval-upcase ()
  (should (equal (typespec-eval '(upcase "a"))
                 '(const "A")))
  (should (equal (typespec-eval '(upcase (or "a" "b" "c")))
                 '(or (const "A") (const "B") (const "C"))))
  (should (equal (typespec-eval '(upcase string))
                 'string)))

(ert-deftest typespec-eval-downcase ()
  (should (equal (typespec-eval '(downcase "A"))
                 '(const "a")))
  (should (equal (typespec-eval '(downcase (or "A" "B" "C")))
                 '(or (const "a") (const "b") (const "c"))))
  (should (equal (typespec-eval '(downcase string))
                 'string)))

(ert-deftest typespec-eval-string-to-number ()
  (should (equal (typespec-eval '(string-to-number "1"))
                 '(const 1)))
  (should (equal (typespec-eval '(string-to-number "a"))
                 '(const 0)))
  (should (equal (typespec-eval '(string-to-number "1.1"))
                 '(const 1.1)))
  (should (equal (typespec-eval '(string-to-number string))
                 'number))
  (should (equal (typespec-eval '(string-to-number (or "1" "2")))
                 '(or (const 1) (const 2)))))

(ert-deftest typespec-eval-capitalize ()
  (should (equal (typespec-eval '(capitalize "foo"))
                 '(const "Foo")))
  (should (equal (typespec-eval '(capitalize (or "foo" "bar")))
                 '(or (const "Foo") (const "Bar"))))
  (should (equal (typespec-eval '(capitalize string))
                 'string)))

(ert-deftest typespec-eval-number-to-string ()
  (should (equal (typespec-eval '(number-to-string 42))
                 '(const "42")))
  (should (equal (typespec-eval '(number-to-string 1.5))
                 '(const "1.5")))
  (should (equal (typespec-eval '(number-to-string number))
                 'string)))

(ert-deftest typespec-eval-abs ()
  (should (equal (typespec-eval '(abs -2))
                 '(const 2)))
  (should (equal (typespec-eval '(abs 1.5))
                 '(const 1.5)))
  (should (equal (typespec-eval '(abs integer))
                 'integer))
  (should (equal (typespec-eval '(abs float))
                 'float))
  (should (equal (typespec-eval '(abs number))
                 'number)))

(ert-deftest typespec-eval-rounding ()
  (should (equal (typespec-eval '(floor 1.9))
                 '(const 1)))
  (should (equal (typespec-eval '(ceiling 1.2))
                 '(const 2)))
  (should (equal (typespec-eval '(round 1.2))
                 '(const 1)))
  (should (equal (typespec-eval '(truncate -1.7))
                 '(const -1)))
  (should (equal (typespec-eval '(floor number))
                 'integer))
  (should (equal (typespec-eval '(ceiling number))
                 'integer))
  (should (equal (typespec-eval '(round number))
                 'integer))
  (should (equal (typespec-eval '(truncate number))
                 'integer)))

(ert-deftest typespec-eval-min-max ()
  (should (equal (typespec-eval '(max 1 5 3))
                 '(const 5)))
  (should (equal (typespec-eval '(min 1 5 3))
                 '(const 1)))
  (should (equal (typespec-eval '(max integer integer))
                 'integer))
  (should (equal (typespec-eval '(min float float))
                 'float))
  (should (equal (typespec-eval '(max number number))
                 'number)))

(ert-deftest typespec-eval-string-trim ()
  (should (equal (typespec-eval '(string-trim "  foo  "))
                 '(const "foo")))
  (should (equal (typespec-eval '(string-trim (or " a " " b ")))
                 '(or (const "a") (const "b"))))
  (should (equal (typespec-eval '(string-trim string))
                 'string)))

(ert-deftest typespec-eval-string-equal ()
  (should (equal (typespec-eval '(string-equal "a" "a"))
                 '(const t)))
  (should (equal (typespec-eval '(string-equal "a" "b"))
                 '(const nil)))
  (should (equal (typespec-eval '(string-equal string string))
                 'boolean))
  (should (equal (typespec-eval '(string-equal (or "a" "b") "a"))
                 'boolean)))

(ert-deftest typespec-eval-string-prefix-p ()
  (should (equal (typespec-eval '(string-prefix-p "a" "abc"))
                 '(const t)))
  (should (equal (typespec-eval '(string-prefix-p "a" "xyz"))
                 '(const nil)))
  (should (equal (typespec-eval '(string-prefix-p string string))
                 'boolean))
  (should (equal (typespec-eval '(string-prefix-p (or "a" "b") "abc"))
                 'boolean)))

(ert-deftest typespec-eval-not-null ()
  (should (equal (typespec-eval '(not (const nil)))
                 '(const t)))
  (should (equal (typespec-eval '(not (const t)))
                 '(const nil)))
  (should (equal (typespec-eval '(not (list unknown)))
                 'boolean))
  (should (equal (typespec-eval '(not (list+ unknown)))
                 '(const nil)))
  (should (equal (typespec-eval '(not unknown))
                 'boolean))
  (should (equal (typespec-eval '(not (not (const nil))))
                 '(const nil)))
  (should (equal (typespec-eval '(not boolean))
                 'boolean))
  (should (equal (typespec-eval '(not string))
                 '(const nil)))
  (should (equal (typespec-eval '(null (const nil)))
                 '(const t)))
  (should (equal (typespec-eval '(null string))
                 '(const nil)))
  (should (equal (typespec-eval '(null (list unknown)))
                 'boolean))
  (should (equal (typespec-eval '(null (list+ unknown)))
                 '(const nil))))

(ert-deftest typespec-eval-concat ()
  (should (equal (typespec-eval '(concat "a" "b" "c"))
                 '(const "abc")))
  (should (equal (typespec-eval '(concat string string))
                 'string))
  (should (equal (typespec-eval '(concat (const "x") string))
                 '(and string (not (const ""))))))

(ert-deftest typespec-eval-length ()
  (should (equal (typespec-eval '(length string))
                 '(integer 0 *)))
  (should (equal (typespec-eval '(length list))
                 '(integer 0 *)))
  (should (equal (typespec-eval '(length (list+ unknown)))
                 '(integer 1 *)))
  (should (equal (typespec-eval '(length "ab"))
                 '(const 2))))

(ert-deftest typespec-eval-string-bytes ()
  (should (equal (typespec-eval '(string-bytes string))
                 '(integer 0 *)))
  (should (equal (typespec-eval '(string-bytes "ab"))
                 '(const 2))))

(ert-deftest typespec-eval-substring ()
  (should (equal (typespec-eval '(substring string 0 1))
                 '(and string (not (const "")))))
  (should (equal (typespec-eval '(substring string int int))
                 'string))
  (should (equal (typespec-eval '(substring string int positive-int))
                 '(and string (not (const "")))))
  (should (equal (typespec-eval '(substring "abc" 1 2))
                 '(const "b"))))

(ert-deftest typespec-eval-string-reverse ()
  (should (equal (typespec-eval '(string-reverse "abc"))
                 '(const "cba")))
  (should (equal (typespec-eval '(string-reverse string))
                 'string)))

(ert-deftest typespec-eval-string-trim-left-right ()
  (should (equal (typespec-eval '(string-trim-left "  foo"))
                 '(const "foo")))
  (should (equal (typespec-eval '(string-trim-right "foo  "))
                 '(const "foo")))
  (should (equal (typespec-eval '(string-trim-left string))
                 'string))
  (should (equal (typespec-eval '(string-trim-right string))
                 'string)))

(ert-deftest typespec-eval-string-pad ()
  (should (equal (typespec-eval '(string-pad "a" 3 ?x))
                 '(const "axx")))
  (should (equal (typespec-eval '(string-pad string (integer 0 *)))
                 'string))
  (should (equal (typespec-eval '(string-pad string positive-int))
                 '(and string (not (const ""))))))

(ert-deftest typespec-eval-string-remove-prefix-suffix ()
  (should (equal (typespec-eval '(string-remove-prefix "pre" "prefix"))
                 '(const "fix")))
  (should (equal (typespec-eval '(string-remove-suffix "fix" "prefix"))
                 '(const "pre")))
  (should (equal (typespec-eval '(string-remove-prefix string string))
                 'string))
  (should (equal (typespec-eval '(string-remove-suffix string string))
                 'string)))

(ert-deftest typespec-eval-string-to-char-list-vector ()
  (should (equal (typespec-eval '(string-to-char "abc"))
                 '(const 97)))
  (should (equal (typespec-eval '(string-to-char string))
                 'integer))
  (should (equal (typespec-eval '(string-to-list "ab"))
                 '(const (97 98))))
  (should (equal (typespec-eval '(string-to-list string))
                 '(list integer)))
  (should (equal (typespec-eval '(string-to-vector "ab"))
                 '(const [97 98])))
  (should (equal (typespec-eval '(string-to-vector string))
                 '(vector integer))))

(provide 'typespec-eval-test)
;;; typespec-eval-test.el ends here
