  (should (equal (typespec-eval '(generalize (const t) boolean))
                 'boolean))
  (should (equal (typespec-eval '(generalize integer number))
                 'number))
  (should (equal (typespec-eval '(generalize (integer 0 10) integer))
                 'integer))
  (should (equal (typespec-eval '(generalize string number))
                 '(generalize string number)))
  (should (equal (typespec-eval '(generalize-signed (const -2)))
                 'negative-int))
  (should (equal (typespec-eval '(generalize-signed (const 2.0)))
                 'positive-float))
  (should (equal (typespec-eval '(generalize-signed (const 0)))
                 '(const 0)))
  (should (equal (typespec-eval '(generalize-signed integer))
