;;; Commentary:

;; Tests for the typespec evaluator.

;;; Code:

(require 'ert)
(require 'seq)
(require 'typespec-eval)

(ert-deftest typespec-eval-eq ()
  (should (equal (typespec-eval '(eq (const 1) (const 1)))
                 '(const t)))
  (should (equal (typespec-eval '(eq (const 1) (const 2)))
                 '(const nil)))
  (should (equal (typespec-eval '(eq number number)) 'boolean))
  (should (equal (typespec-eval '(eq unknown unknown)) 'boolean)))

(ert-deftest typespec-eval-upcase ()
  (should (equal (typespec-eval '(upcase "a"))
                 '(const "A")))
  (should (equal (typespec-eval '(upcase (or "a" "b" "c")))
                 '(or (const "A") (const "B") (const "C"))))
  (should (equal (typespec-eval '(upcase string))
                 'string)))

(ert-deftest typespec-eval-downcase ()
  (should (equal (typespec-eval '(downcase "A"))
                 '(const "a")))
  (should (equal (typespec-eval '(downcase (or "A" "B" "C")))
                 '(or (const "a") (const "b") (const "c"))))
  (should (equal (typespec-eval '(downcase string))
                 'string)))

(ert-deftest typespec-eval-string-to-number ()
  (should (equal (typespec-eval '(string-to-number "1"))
                 '(const 1)))
  (should (equal (typespec-eval '(string-to-number "a"))
                 '(const 0)))
  (should (equal (typespec-eval '(string-to-number "1.1"))
                 '(const 1.1)))
  (should (equal (typespec-eval '(string-to-number string))
                 'number))
  (should (equal (typespec-eval '(string-to-number (or "1" "2")))
                 '(or (const 1) (const 2)))))

(ert-deftest typespec-eval-capitalize ()
  (should (equal (typespec-eval '(capitalize "foo"))
                 '(const "Foo")))
  (should (equal (typespec-eval '(capitalize (or "foo" "bar")))
                 '(or (const "Foo") (const "Bar"))))
  (should (equal (typespec-eval '(capitalize string))
                 'string)))

(ert-deftest typespec-eval-number-to-string ()
  (should (equal (typespec-eval '(number-to-string 42))
                 '(const "42")))
  (should (equal (typespec-eval '(number-to-string 1.5))
                 '(const "1.5")))
  (should (equal (typespec-eval '(number-to-string number))
                 'string)))

(ert-deftest typespec-eval-abs ()
  (should (equal (typespec-eval '(abs -2))
                 '(const 2)))
  (should (equal (typespec-eval '(abs 1.5))
                 '(const 1.5)))
  (should (equal (typespec-eval '(abs integer))
                 'integer))
  (should (equal (typespec-eval '(abs float))
                 'float))
  (should (equal (typespec-eval '(abs number))
                 'number)))

(ert-deftest typespec-eval-rounding ()
  (should (equal (typespec-eval '(floor 1.9))
                 '(const 1)))
  (should (equal (typespec-eval '(ceiling 1.2))
                 '(const 2)))
  (should (equal (typespec-eval '(round 1.2))
                 '(const 1)))
  (should (equal (typespec-eval '(truncate -1.7))
                 '(const -1)))
  (should (equal (typespec-eval '(floor number))
                 'integer))
  (should (equal (typespec-eval '(ceiling number))
                 'integer))
  (should (equal (typespec-eval '(round number))
                 'integer))
  (should (equal (typespec-eval '(truncate number))
                 'integer)))

(ert-deftest typespec-eval-add1-sub1 ()
  (should (equal (typespec-eval '(1+ 1))
                 '(const 2)))
  (should (equal (typespec-eval '(1- 1))
                 '(const 0)))
  (should (equal (typespec-eval '(1+ integer))
                 'integer))
  (should (equal (typespec-eval '(1- float))
                 'float))
  (should (equal (typespec-eval '(1+ number))
                 'number)))

(ert-deftest typespec-eval-arithmetic ()
  (should (equal (typespec-eval '(+ 1 2 3))
                 '(const 6)))
  (should (equal (typespec-eval '(* 2 3))
                 '(const 6)))
  (should (equal (typespec-eval '(- 3 1))
                 '(const 2)))
  (should (equal (typespec-eval '(/ 8 2))
                 '(const 4)))
  (should (equal (typespec-eval '(% 7 3))
                 '(const 1)))
  (should (equal (typespec-eval '(mod 7 3))
                 '(const 1)))
  (should (equal (typespec-eval '(+ integer integer))
                 'integer))
  (should (equal (typespec-eval '(* float float))
                 'float))
  (should (equal (typespec-eval '(- number number))
                 'number))
  (should (equal (typespec-eval '(mod float float))
                 'float)))

(ert-deftest typespec-eval-bit-ops ()
  (should (equal (typespec-eval '(logand 7 3))
                 '(const 3)))
  (should (equal (typespec-eval '(logior 1 4))
                 '(const 5)))
  (should (equal (typespec-eval '(logxor 6 3))
                 '(const 5)))
  (should (equal (typespec-eval '(lognot 0))
                 '(const -1)))
  (should (equal (typespec-eval '(logcount 7))
                 '(const 3)))
  (should (equal (typespec-eval '(ash 1 2))
                 '(const 4)))
  (should (equal (typespec-eval '(logand integer integer))
                 'integer))
  (should (equal (typespec-eval '(ash integer integer))
                 'integer)))

(ert-deftest typespec-eval-zerop ()
  (should (equal (typespec-eval '(zerop 0))
                 '(const t)))
  (should (equal (typespec-eval '(zerop 1))
                 '(const nil)))
  (should (equal (typespec-eval '(zerop number))
                 'boolean)))

(ert-deftest typespec-eval-log10 ()
  (should (equal (typespec-eval '(log10 100))
                 '(const 2.0)))
  (should (equal (typespec-eval '(log10 number))
                 'float)))

(ert-deftest typespec-eval-lsh ()
  (should (equal (typespec-eval '(lsh 2 1))
                 '(const 4)))
  (should (equal (typespec-eval '(lsh integer integer))
                 'integer)))

(ert-deftest typespec-eval-number-sequence ()
  (should (equal (typespec-eval '(number-sequence 1 3))
                 '(const (1 2 3))))
  (should (equal (typespec-eval '(number-sequence number number))
                 '(list number))))

(ert-deftest typespec-eval-isnan ()
  (should (equal (typespec-eval '(isnan 0.0))
                 '(const nil)))
  (should (equal (typespec-eval '(isnan number))
                 'boolean)))

(ert-deftest typespec-eval-cl-signum ()
  (should (equal (typespec-eval '(cl-signum -2))
                 '(const -1)))
  (should (equal (typespec-eval '(cl-signum 0))
                 '(const 0)))
  (should (equal (typespec-eval '(cl-signum 3))
                 '(const 1)))
  (should (equal (typespec-eval '(cl-signum integer))
                 'integer))
  (should (equal (typespec-eval '(cl-signum number))
                 'number)))

(ert-deftest typespec-eval-min-max ()
  (should (equal (typespec-eval '(max 1 5 3))
                 '(const 5)))
  (should (equal (typespec-eval '(min 1 5 3))
                 '(const 1)))
  (should (equal (typespec-eval '(max integer integer))
                 'integer))
  (should (equal (typespec-eval '(min float float))
                 'float))
  (should (equal (typespec-eval '(max number number))
                 'number)))

(ert-deftest typespec-eval-string-trim ()
  (should (equal (typespec-eval '(string-trim "  foo  "))
                 '(const "foo")))
  (should (equal (typespec-eval '(string-trim (or " a " " b ")))
                 '(or (const "a") (const "b"))))
  (should (equal (typespec-eval '(string-trim string))
                 'string)))

(ert-deftest typespec-eval-string-width ()
  (should (equal (typespec-eval '(string-width "ab"))
                 '(const 2)))
  (should (equal (typespec-eval '(string-width string))
                 '(integer 0 *))))

(ert-deftest typespec-eval-string-lines ()
  (should (equal (typespec-eval '(string-lines "a\nb"))
                 '(const ("a" "b"))))
  (should (equal (typespec-eval '(string-lines string))
                 '(list string))))

(ert-deftest typespec-eval-string-match-p ()
  (should (equal (typespec-eval '(string-match-p "b" "abc"))
                 '(const 1)))
  (should (equal (typespec-eval '(string-match-p "z" "abc"))
                 '(const nil)))
  (should (equal (typespec-eval '(string-match-p string string))
                 'boolean)))

(ert-deftest typespec-eval-string-conversions ()
  (should (equal (typespec-eval '(string-as-multibyte "a"))
                 '(const "a")))
  (should (equal (typespec-eval '(string-as-unibyte "a"))
                 '(const "a")))
  (should (equal (typespec-eval '(string-to-multibyte "a"))
                 '(const "a")))
  (should (equal (typespec-eval '(string-to-unibyte "a"))
                 '(const "a")))
  (should (equal (typespec-eval '(string-as-multibyte string))
                 'string))
  (should (equal (typespec-eval '(string-to-unibyte string))
                 'string)))

(ert-deftest typespec-eval-string-cleaners ()
  (should (equal (typespec-eval '(string-chop-newline "a\n"))
                 '(const "a")))
  (should (equal (typespec-eval '(string-clean-whitespace " a  b\t"))
                 '(const "a b")))
  (should (equal (typespec-eval '(string-chop-newline string))
                 'string))
  (should (equal (typespec-eval '(string-clean-whitespace string))
                 'string)))

(ert-deftest typespec-eval-string-limit-distance ()
  (should (equal (typespec-eval '(string-limit "abcdef" 3))
                 '(const "abc")))
  (should (equal (typespec-eval '(string-limit string integer))
                 'string))
  (should (equal (typespec-eval '(string-distance "a" "b"))
                 '(const 1)))
  (should (equal (typespec-eval '(string-distance string string))
                 'integer)))

(ert-deftest typespec-eval-char-to-make-string ()
  (should (equal (typespec-eval '(char-to-string 97))
                 '(const "a")))
  (should (equal (typespec-eval '(char-to-string integer))
                 '(and string (not (const "")))))
  (should (equal (typespec-eval '(make-string 3 120))
                 '(const "xxx")))
  (should (equal (typespec-eval '(make-string 0 120))
                 '(const "")))
  (should (equal (typespec-eval '(make-string positive-int integer))
                 '(and string (not (const "")))))
  (should (equal (typespec-eval '(make-string integer integer))
                 'string)))

(ert-deftest typespec-eval-string-version-lessp ()
  (should (equal (typespec-eval '(string-version-lessp "1.0" "2.0"))
                 '(const t)))
  (should (equal (typespec-eval '(string-version-lessp string string))
                 'boolean)))

(ert-deftest typespec-eval-string-join ()
  (should (equal (typespec-eval '(string-join (const ("a" "b")) "-"))
                 '(const "a-b")))
  (should (equal (typespec-eval '(string-join (list string)))
                 'string)))

(ert-deftest typespec-eval-string-search ()
  (should (equal (typespec-eval '(string-search "b" "abc"))
                 '(const 1)))
  (should (equal (typespec-eval '(string-search "z" "abc"))
                 '(const nil)))
  (should (equal (typespec-eval '(string-search string string))
                 '(or (const nil) integer))))

(ert-deftest typespec-eval-string-split ()
  (should (equal (typespec-eval '(string-split "a,b" ","))
                 '(const ("a" "b"))))
  (should (equal (typespec-eval '(string-split string))
                 '(list string))))

(ert-deftest typespec-eval-string-replace ()
  (should (equal (typespec-eval '(string-replace "a" "b" "aab"))
                 '(const "bbb")))
  (should (equal (typespec-eval '(string-replace string string string))
                 'string)))

(ert-deftest typespec-eval-string-truncate-left ()
  (should (equal (typespec-eval '(string-truncate-left "abcdef" 3))
                 '(const "...f")))
  (should (equal (typespec-eval '(string-truncate-left string integer))
                 'string)))

(ert-deftest typespec-eval-string-suffix-p ()
  (should (equal (typespec-eval '(string-suffix-p "c" "abc"))
                 '(const t)))
  (should (equal (typespec-eval '(string-suffix-p "z" "abc"))
                 '(const nil)))
  (should (equal (typespec-eval '(string-suffix-p string string))
                 'boolean)))

(ert-deftest typespec-eval-string-compare ()
  (should (equal (typespec-eval '(string-lessp "a" "b"))
                 '(const t)))
  (should (equal (typespec-eval '(string-greaterp "a" "b"))
                 '(const nil)))
  (should (equal (typespec-eval '(string< "a" "b"))
                 '(const t)))
  (should (equal (typespec-eval '(string> "a" "b"))
                 '(const nil)))
  (should (equal (typespec-eval '(string= "a" "a"))
                 '(const t)))
  (should (equal (typespec-eval '(string-lessp string string))
                 'boolean))
  (should (equal (typespec-eval '(string-greaterp string string))
                 'boolean))
  (should (equal (typespec-eval '(string-equal-ignore-case "A" "a"))
                 '(const t)))
  (should (equal (typespec-eval '(string-equal-ignore-case string string))
                 'boolean)))

(ert-deftest typespec-eval-string-equal ()
  (should (equal (typespec-eval '(string-equal "a" "a"))
                 '(const t)))
  (should (equal (typespec-eval '(string-equal "a" "b"))
                 '(const nil)))
  (should (equal (typespec-eval '(string-equal string string))
                 'boolean))
  (should (equal (typespec-eval '(string-equal (or "a" "b") "a"))
                 'boolean)))

(ert-deftest typespec-eval-string-prefix-p ()
  (should (equal (typespec-eval '(string-prefix-p "a" "abc"))
                 '(const t)))
  (should (equal (typespec-eval '(string-prefix-p "a" "xyz"))
                 '(const nil)))
  (should (equal (typespec-eval '(string-prefix-p string string))
                 'boolean))
  (should (equal (typespec-eval '(string-prefix-p (or "a" "b") "abc"))
                 'boolean)))

(ert-deftest typespec-eval-not-null ()
  (should (equal (typespec-eval '(not (const nil)))
                 '(const t)))
  (should (equal (typespec-eval '(not (const t)))
                 '(const nil)))
  (should (equal (typespec-eval '(not (list unknown)))
                 'boolean))
  (should (equal (typespec-eval '(not (list+ unknown)))
                 '(const nil)))
  (should (equal (typespec-eval '(not unknown))
                 'boolean))
  (should (equal (typespec-eval '(not (not (const nil))))
                 '(const nil)))
  (should (equal (typespec-eval '(not boolean))
                 'boolean))
  (should (equal (typespec-eval '(not string))
                 '(const nil)))
  (should (equal (typespec-eval '(null (const nil)))
                 '(const t)))
  (should (equal (typespec-eval '(null string))
                 '(const nil)))
  (should (equal (typespec-eval '(null (list unknown)))
                 'boolean))
  (should (equal (typespec-eval '(null (list+ unknown)))
                 '(const nil))))

(ert-deftest typespec-eval-concat ()
  (should (equal (typespec-eval '(concat "a" "b" "c"))
                 '(const "abc")))
  (should (equal (typespec-eval '(concat string string))
                 'string))
  (should (equal (typespec-eval '(concat (const "x") string))
                 '(and string (not (const ""))))))

(ert-deftest typespec-eval-length ()
  (should (equal (typespec-eval '(length string))
                 '(integer 0 *)))
  (should (equal (typespec-eval '(length list))
                 '(integer 0 *)))
  (should (equal (typespec-eval '(length (list+ unknown)))
                 '(integer 1 *)))
  (should (equal (typespec-eval '(length "ab"))
                 '(const 2))))

(ert-deftest typespec-eval-string-bytes ()
  (should (equal (typespec-eval '(string-bytes string))
                 '(integer 0 *)))
  (should (equal (typespec-eval '(string-bytes "ab"))
                 '(const 2))))

(ert-deftest typespec-eval-substring ()
  (should (equal (typespec-eval '(substring string 0 1))
                 '(and string (not (const "")))))
  (should (equal (typespec-eval '(substring string int int))
                 'string))
  (should (equal (typespec-eval '(substring string int positive-int))
                 '(and string (not (const "")))))
  (should (equal (typespec-eval '(substring "abc" 1 2))
                 '(const "b"))))

(ert-deftest typespec-eval-string-reverse ()
  (should (equal (typespec-eval '(string-reverse "abc"))
                 '(const "cba")))
  (should (equal (typespec-eval '(string-reverse string))
                 'string)))

(ert-deftest typespec-eval-string-trim-left-right ()
  (should (equal (typespec-eval '(string-trim-left "  foo"))
                 '(const "foo")))
  (should (equal (typespec-eval '(string-trim-right "foo  "))
                 '(const "foo")))
  (should (equal (typespec-eval '(string-trim-left string))
                 'string))
  (should (equal (typespec-eval '(string-trim-right string))
                 'string)))

(ert-deftest typespec-eval-string-pad ()
  (should (equal (typespec-eval '(string-pad "a" 3 ?x))
                 '(const "axx")))
  (should (equal (typespec-eval '(string-pad string (integer 0 *)))
                 'string))
  (should (equal (typespec-eval '(string-pad string positive-int))
                 '(and string (not (const ""))))))

(ert-deftest typespec-eval-string-remove-prefix-suffix ()
  (should (equal (typespec-eval '(string-remove-prefix "pre" "prefix"))
                 '(const "fix")))
  (should (equal (typespec-eval '(string-remove-suffix "fix" "prefix"))
                 '(const "pre")))
  (should (equal (typespec-eval '(string-remove-prefix string string))
                 'string))
  (should (equal (typespec-eval '(string-remove-suffix string string))
                 'string)))

(ert-deftest typespec-eval-string-to-char-list-vector ()
  (should (equal (typespec-eval '(string-to-char "abc"))
                 '(const 97)))
  (should (equal (typespec-eval '(string-to-char string))
                 'integer))
  (should (equal (typespec-eval '(string-to-list "ab"))
                 '(const (97 98))))
  (should (equal (typespec-eval '(string-to-list string))
                 '(list integer)))
  (should (equal (typespec-eval '(string-to-vector "ab"))
                 '(const [97 98])))
  (should (equal (typespec-eval '(string-to-vector string))
                 '(vector integer))))

(provide 'typespec-eval-test)
