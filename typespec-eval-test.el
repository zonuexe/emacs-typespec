                 '(cons string integer)))
  (should (equal (typespec-eval '(sequence (or integer string)))
                 '(sequence (or integer string))))
  (should (equal (typespec-eval '(hash-table symbol string))
                 '(hash-table symbol string)))
  (should (equal (typespec-eval '(:class my-class))
                 '(:class my-class)))
  (should (equal (typespec-eval '(:plist-of (:name string) (:? :age integer)))
                 '(:plist-of (:name string) (:? :age integer))))
  (should (equal (typespec-eval '(function (string integer) (or string integer)))
                 '(function (string integer) (or string integer))))
  (should (equal (typespec-eval '(function (unknown) (:guard string)))
                 '(function (unknown) (:guard string))))
  (should (equal (typespec-eval '(function (unknown) (:guard! string)))
                 '(function (unknown) (:guard! string))))
  (should (equal (typespec-eval '(function (unknown) (:assert integer)))
                 '(function (unknown) (:assert integer))))
  (should (equal (typespec-eval '(generalize (const 42) integer))
