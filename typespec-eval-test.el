(ert-deftest typespec-eval-abs ()
  (should (equal (typespec-eval '(abs -2))
                 '(const 2)))
  (should (equal (typespec-eval '(abs 1.5))
                 '(const 1.5)))
  (should (equal (typespec-eval '(abs integer))
                 'integer))
  (should (equal (typespec-eval '(abs float))
                 'float))
  (should (equal (typespec-eval '(abs (float 1.0 2.0)))
                 '(float 1.0 2.0)))
  (should (equal (typespec-eval '(abs (float -1 1)))
                 '(float 0.0 1.0)))
  (should (equal (typespec-eval '(abs (float -2 1)))
                 '(float 0.0 2.0)))
  (should (equal (typespec-eval '(abs (integer -5 -2)))
                 '(integer 2 5)))
  (should (equal (typespec-eval '(abs (integer -5 2)))
                 '(integer 0 5)))
  (should (equal (typespec-eval '(abs (integer 3 5)))
                 '(integer 3 5)))
  (should (equal (typespec-eval '(abs (integer * -1)))
                 '(integer 1 *)))
  (should (equal (typespec-eval '(abs (integer * 0)))
                 '(integer 0 *)))
  (should (equal (typespec-eval '(abs positive-int))
                 '(integer 1 *)))
  (should (equal (typespec-eval '(abs negative-int))
                 '(integer 1 *)))
  (should (equal (typespec-eval '(abs non-positive-int))
                 '(integer 0 *)))
  (should (equal (typespec-eval '(abs number))
                 'number)))

(ert-deftest typespec-eval-rounding ()
  (should (equal (typespec-eval '(floor 1.9))
                 '(const 1)))
  (should (equal (typespec-eval '(ceiling 1.2))
                 '(const 2)))
  (should (equal (typespec-eval '(round 1.2))
                 '(const 1)))
  (should (equal (typespec-eval '(truncate -1.7))
                 '(const -1)))
  (should (equal (typespec-eval '(floor (float 1.1 2.9)))
                 '(integer 1 2)))
  (should (equal (typespec-eval '(ceiling (float 1.1 2.1)))
                 '(integer 2 3)))
  (should (equal (typespec-eval '(round (float 1.1 2.1)))
                 '(integer 1 2)))
  (should (equal (typespec-eval '(round (float (1.0) (3.0))))
                 '(integer 1 3)))
  (should (equal (typespec-eval '(truncate (float -2.4 -1.1)))
                 '(integer -2 -1)))
  (should (equal (typespec-eval '(floor number))
                 'integer))
  (should (equal (typespec-eval '(ceiling number))
                 'integer))
  (should (equal (typespec-eval '(round number))
                 'integer))
  (should (equal (typespec-eval '(truncate number))
                 'integer)))

(ert-deftest typespec-eval-add1-sub1 ()
